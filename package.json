{
  "name": "coaching-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "test:e2e": "pnpm --filter @coaching-os/web run test:e2e",
    "test:db:setup": "pnpm --filter @coaching-os/database run test:db:setup",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:check": "pnpm --filter @coaching-os/config run env:check",
    "verify:auth": "pnpm --filter @coaching-os/auth run verify:auth",
    "verify:infra": "pnpm --filter @coaching-os/observability run verify:infra",
    "db:validate": "pnpm --filter @coaching-os/database run db:validate",
    "db:generate": "pnpm --filter @coaching-os/database run db:generate",
    "db:migrate": "pnpm --filter @coaching-os/database run db:migrate",
    "db:migrate:deploy": "pnpm --filter @coaching-os/database run db:migrate:deploy",
    "db:status": "pnpm --filter @coaching-os/database run db:status",
    "db:drift:check": "pnpm --filter @coaching-os/database run db:drift:check",
    "db:seed": "pnpm --filter @coaching-os/database run db:seed",
    "db:health": "pnpm --filter @coaching-os/database run db:health"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.15.0"
}
