# CoachingOS Environment Variables Baseline (Phase 0.6)

# Database Connection String (Server-Only)
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/coachingos?schema=public"
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/coachingos_test?schema=public"

# Runtime Mode
NODE_ENV="development"

# Server Port
PORT="3000"

# Application Public URL (Client-Safe)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Foundation (Server-Only)
BETTER_AUTH_SECRET="coachingos_dev_secret_key_32_chars_min_length_required_here!"
BETTER_AUTH_URL="http://localhost:3000"
